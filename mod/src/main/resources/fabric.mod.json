{
  "schemaVersion": 1,
  "id": "qqchatbridge",
  "version": "${version}",
  "name": "QQ Chat Bridge",
  "description": "Minecraft 聊天栏与 QQ 群双向互通的纯客户端模组（OneBot 11 / NapCat）。",
  "authors": [
    "qqchatbridge"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.qqchatbridge.QqChatBridge"
    ]
  },
  "mixins": [
    "qqchatbridge.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
