# QQ Relay 配置
listenHost=+
listenPort=18574
napcatWs=ws://127.0.0.1:3001
napcatHttp=http://127.0.0.1:3000
# 客户端访问 relay 用的 Token
token=CHANGE_ME_RELAY_TOKEN
# relay 连接本机 NapCat 用的 Token（与 NapCat onebot11 配置一致）
napcatToken=CHANGE_ME_NAPCAT_TOKEN
allowIps=
maxClients=64
ratePerMinute=120
logFile=relay.log